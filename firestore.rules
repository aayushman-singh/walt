rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read and write their own user document
    match /users/{userId} {
      // Allow read if authenticated and accessing own document
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Allow write if authenticated and accessing own document
      allow create, update: if request.auth != null && request.auth.uid == userId;
      
      // Allow delete only for own document
      allow delete: if request.auth != null && request.auth.uid == userId;
      
      // Allow access to files subcollection
      match /files/{fileId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Allow access to fileVersions subcollection
      match /fileVersions/{versionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Owner-only secrets (e.g. the passphrase-encrypted identity private key).
      // Never readable by other users — kept out of the public directory so a
      // peer lookup cannot obtain an offline passphrase-cracking target.
      match /secrets/{secretId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Public-key directory for cryptographic sharing. Any signed-in user may READ
    // another user's published ECDH public identity (it is public by design), but
    // only the owner may write their own entry. Contains no secret material.
    match /publicKeys/{userId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}

