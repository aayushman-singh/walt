rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read and write their own user document
    match /users/{userId} {
      // Allow read if authenticated and accessing own document
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Allow write if authenticated and accessing own document
      allow create, update: if request.auth != null && request.auth.uid == userId;
      
      // Allow delete only for own document
      allow delete: if request.auth != null && request.auth.uid == userId;
      
      // Allow access to files subcollection
      match /files/{fileId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Allow access to fileVersions subcollection
      match /fileVersions/{versionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Owner-only secrets (e.g. the passphrase-encrypted identity private key).
      // Never readable by other users — kept out of the public directory so a
      // peer lookup cannot obtain an offline passphrase-cracking target.
      match /secrets/{secretId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Public-key directory for cryptographic sharing. Any signed-in user may READ
    // another user's published ECDH public identity (it is public by design), but
    // only the owner may write their own entry. CRITICAL: the email→key binding is
    // the root of trust for "share by email", so `emailLower` may only be set to
    // the writer's OWN authenticated token email — otherwise an attacker could
    // claim a victim's email and have shares encrypted to the attacker's key.
    match /publicKeys/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.emailLower == request.auth.token.email;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Encrypted-share inbox. A sender writes one record into the RECIPIENT's
    // inbox (sharedWithMe/{recipientUid}/items/{shareId}); the recipient reads
    // their own inbox. The payload is an ECIES envelope — confidentiality comes
    // from the crypto, not the rules, so a sender writing here learns nothing.
    //
    //   - read   : only the inbox owner (the recipient).
    //   - create : any authenticated user (a sender depositing into an inbox),
    //              constrained to a well-formed record that names the sender as
    //              itself (no spoofing `from`) and carries the share envelope.
    //   - delete : only the inbox owner (recipient can dismiss an item).
    //   - update : forbidden — records are immutable once deposited.
    match /sharedWithMe/{userId}/items/{shareId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.resource.data.from == request.auth.uid
        // Bind the displayed sender email to the authenticated identity so a
        // malicious sender cannot forge `fromEmail` to look like a trusted user.
        && request.resource.data.fromEmail == request.auth.token.email
        && request.resource.data.cid is string
        && request.resource.data.meta is map
        && request.resource.data.context is string;
      allow update: if false;
    }
  }
}

