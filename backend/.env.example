# Walt backend environment — TEMPLATE.
# Copy to .env and fill in real values:  cp backend/.env.example backend/.env
# Every variable the backend actually reads is listed below. NO real secrets here.
# .env and any Firebase service-account JSON are gitignored — keep them out of git.
#
# When running via docker compose, IPFS_API_URL / DATABASE_URL / PORT / NODE_ENV are
# ALSO set in docker-compose.yml (the compose values win). The values here are the
# correct defaults for a bare `node server.js` run and document intent.

# ============================================
# Database (SQLite) — backend/db.js
# ============================================
# The "sqlite://" prefix is stripped; the remainder is the file path opened by
# better-sqlite3. WAL mode also creates <file>-wal and <file>-shm beside it.
# Under docker compose this is overridden to point at the persistent /data volume.
DATABASE_URL=sqlite:///data/ipfs-drive.db

# ============================================
# IPFS node (Kubo) — backend/ipfs.js
# ============================================
# Under docker compose, reach the node by its service name "ipfs".
# For a bare local run against a host IPFS daemon, use http://127.0.0.1:5001.
IPFS_API_URL=http://ipfs:5001

# ============================================
# Firebase Admin SDK — backend/middleware/auth.js
# ============================================
# REQUIRED for authentication. With NO valid creds the app starts but every
# authenticated route returns 503 (fail-loud, no silent fallback).
#
# Two ways to provide credentials (pick ONE):
#
# (A) The trio below (recommended; matches the existing template). Get them from:
#     Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key.
#     PRIVATE_KEY: paste the whole key on one line with literal \n for newlines,
#     wrapped in double quotes (the code converts \n back to real newlines).
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_LINES\n-----END PRIVATE KEY-----\n"
#
# (B) Inline full service-account JSON in ONE variable (takes priority over the trio).
#     Paste the entire downloaded JSON as a single-line value. If you set this,
#     the trio above is ignored. Leave blank to use the trio.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# ============================================
# Server — backend/server.js, backend/logger.js
# ============================================
PORT=3001
NODE_ENV=production
# pino log level: trace|debug|info|warn|error|fatal. Defaults: info (prod), debug (dev).
LOG_LEVEL=info

# ============================================
# CORS — NOTE
# ============================================
# server.js does NOT read ALLOWED_ORIGINS; the comment in server.js states CORS is
# handled by the reverse proxy (nginx) in production. Configure CORS at your proxy.
# Kept here only so operators coming from the old template are not surprised.
# ALLOWED_ORIGINS=https://walt.aayushman.dev,http://localhost:3000

# ============================================
# Public URLs — used to build share links and the Cashfree return/notify URLs
# (backend/routes/shares.js, payments.js, paymentService.js, billing.js)
# ============================================
FRONTEND_URL=https://walt.aayushman.dev
BACKEND_URL=https://your-backend-host.example.com

# ============================================
# Cashfree payments — OPTIONAL (backend/paymentService.js, routes/billing.js)
# Leave blank to run without billing. Get keys from https://merchant.cashfree.com/
# ============================================
# SANDBOX (test) or PRODUCTION (live charges). Also accepts X_ENVIRONMENT.
CASHFREE_ENVIRONMENT=SANDBOX
# Live credentials (used when ENVIRONMENT=PRODUCTION; also the fallback in SANDBOX
# if no *_TEST keys are set). X_CLIENT_ID/X_CLIENT_SECRET are accepted aliases.
CASHFREE_X_CLIENT_ID=
CASHFREE_X_CLIENT_SECRET=
# Sandbox-only credentials (preferred when ENVIRONMENT=SANDBOX). Optional.
# CASHFREE_X_CLIENT_ID_TEST=
# CASHFREE_X_CLIENT_SECRET_TEST=

# ============================================
# Billing tuning — OPTIONAL (backend/billingUtils.js)
# ============================================
# Free storage allowance in GB before charges apply.
FREE_TIER_GB=5
# Price per GB per month (USD) above the free tier.
COST_PER_GB_USD=0.40
# Minimum charge in INR (useful for low-value test payments).
MIN_CHARGE_INR=1
